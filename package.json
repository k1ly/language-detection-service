{
  "name": "language-detection-service",
  "version": "1.0.0",
  "description": "Language detection service for post content.",
  "author": "Kirill Lyskov",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "language-detection",
    "text-analysis",
    "nlp",
    "tinyld",
    "postgres",
    "json",
    "typescript"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "postbuild": "tsc-alias",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "remove-markdown": "^0.6.4",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
