{
  "compilerOptions": {
    "target": "ES2025",
    "module": "CommonJS",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "declaration": true,
    "incremental": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "vitest.config.ts"]
}
